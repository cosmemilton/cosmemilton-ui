{
  "name": "cosmemilton-ui",
  "version": "1.0.3",
  "description": "Biblioteca de componentes React com suporte opcional a Next para projetos Cosme Milton.",
  "license": "ISC",
  "homepage": "https://miltonjunior.dev.br/cosmemilton-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmemilton/cosmemilton-ui.git"
  },
  "bugs": {
    "url": "https://github.com/cosmemilton/cosmemilton-ui/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "components",
    "ui",
    "design-system",
    "cosmemilton"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components/ui": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/components/ui/index.js",
      "default": "./dist/components/ui/index.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    },
    "./components/theme": {
      "types": "./dist/components/theme/index.d.ts",
      "import": "./dist/components/theme/index.js",
      "default": "./dist/components/theme/index.js"
    },
    "./components/theme/*": {
      "types": "./dist/components/theme/*.d.ts",
      "import": "./dist/components/theme/*.js",
      "default": "./dist/components/theme/*.js"
    },
    "./lib/theme": {
      "types": "./dist/lib/theme/index.d.ts",
      "import": "./dist/lib/theme/index.js",
      "default": "./dist/lib/theme/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "next": ">=15 || >=16",
    "react": ">=18.2 || >=19",
    "react-dom": ">=18.2 || >=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "lucide-react": "^0.553.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}